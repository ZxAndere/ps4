set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT DEFINED ENV{FRAMEGEN_MINGW_ROOT})
  message(FATAL_ERROR "Set FRAMEGEN_MINGW_ROOT to the extracted MinGW prefix (containing usr)")
endif()
set(CMAKE_CXX_COMPILER "$ENV{FRAMEGEN_MINGW_ROOT}/usr/bin/x86_64-w64-mingw32-g++-posix")
set(CMAKE_RC_COMPILER "$ENV{FRAMEGEN_MINGW_ROOT}/usr/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "$ENV{FRAMEGEN_MINGW_ROOT}/usr/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_CXX_FLAGS_INIT "-static-libgcc -static-libstdc++")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-static")
